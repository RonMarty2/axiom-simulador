# Facsímiles de exámenes (225 MB de escaneos). Los PDF NO se versionan: el
# repo se volvería inmanejable y GitHub rechaza archivos grandes. Lo que sí se
# versiona es el inventario, que es el que dice qué hay, qué falta y si un PDF
# nuevo ya está — ver "examenes pasados/INVENTARIO.md".
examenes pasados/**/*.pdf

# PUBLICIDAD: lo pesado y regenerable no se versiona (frames PNG, referencias y descargas)
PUBLICIDAD/motion/*/frames/
PUBLICIDAD/motion/*/prev/
PUBLICIDAD/analisis/frames/
PUBLICIDAD/analisis/audio/
PUBLICIDAD/analisis/contacto.jpg
PUBLICIDAD/referencia/
PUBLICIDAD/FDownloader*.mp4
PUBLICIDAD/audio/frase.txt

# Fotos de examenes (JPG de Facebook/WhatsApp, ~270 MB): misma politica que los PDF
examenes pasados/**/*.jpg
examenes pasados/**/*.jpeg
examenes pasados/**/*.png

